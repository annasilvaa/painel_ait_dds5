import React, { useState } from 'react';
import './App.css'; // Inclua uma folha de estilo para ajustar o layout.

function GerenciamentoTarefas() {
  const [tarefas, setTarefas] = useState([
    { id: 1, descricao: 'Descrição da tarefa 1', usuario: 'Usuário A', estado: 'A Fazer' },
    { id: 2, descricao: 'Descrição da tarefa 2', usuario: 'Usuário B', estado: 'Fazendo' },
    { id: 3, descricao: 'Descrição da tarefa 3', usuario: 'Usuário C', estado: 'Pronto' },
  ]);

  const alterarEstado = (id, novoEstado) => {
    setTarefas((prev) =>
      prev.map((tarefa) =>
        tarefa.id === id ? { ...tarefa, estado: novoEstado } : tarefa
      )
    );
  };

  const renderizarTarefas = (estado) => {
    return tarefas
      .filter((tarefa) => tarefa.estado === estado)
      .map((tarefa) => (
        <div key={tarefa.id} className="tarefa">
          <p><strong>Descrição:</strong> {tarefa.descricao}</p>
          <p><strong>Usuário:</strong> {tarefa.usuario}</p>
          <div className="botoes">
            {estado !== 'A Fazer' && (
              <button onClick={() => alterarEstado(tarefa.id, 'A Fazer')}>Voltar</button>
            )}
            {estado === 'A Fazer' && (
              <button onClick={() => alterarEstado(tarefa.id, 'Fazendo')}>Iniciar</button>
            )}
            {estado === 'Fazendo' && (
              <button onClick={() => alterarEstado(tarefa.id, 'Pronto')}>Concluir</button>
            )}
          </div>
        </div>
      ));
  };

  return (
    <div className="container">
      <h1>Gerenciamento de Tarefas</h1>
      <div className="colunas">
        <div className="coluna">
          <h2>A Fazer</h2>
          {renderizarTarefas('A Fazer')}
        </div>
        <div className="coluna">
          <h2>Fazendo</h2>
          {renderizarTarefas('Fazendo')}
        </div>
        <div className="coluna">
          <h2>Pronto</h2>
          {renderizarTarefas('Pronto')}
        </div>
      </div>
    </div>
  );
}

export default GerenciamentoTarefas;

